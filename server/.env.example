PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5432

# Database (PostgreSQL) - Local or Cloud (Neon.tech / Supabase)
DATABASE_URL="postgresql://crm_user:crm_secure_password_2026@localhost:5432/uttarakhand_crm?schema=public"

# Redis - Local or Cloud (Upstash)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (with rotation)
JWT_ACCESS_SECRET="super_secret_enterprise_access_token_jwt_2026_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super_secret_enterprise_refresh_token_jwt_2026_key"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3 / Cloudflare R2
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="crm-documents"
S3_REGION="auto"
